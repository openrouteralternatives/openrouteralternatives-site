# Firecrawl — used only by the research scripts under scripts/firecrawl.
# The website itself needs no environment variables; it is fully static.
# Get a key at https://www.firecrawl.dev and copy this file to .env (git-ignored).
FIRECRAWL_API_KEY=

# Optional. Override the API base URL (self-hosted Firecrawl, or a different API version).
# FIRECRAWL_API_URL=https://api.firecrawl.dev/v2
